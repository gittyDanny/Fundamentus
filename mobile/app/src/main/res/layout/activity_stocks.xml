<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".StocksActivity"
    tools:openDrawer="start">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Menü -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonOpenMenu"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="Navigationsmenü öffnen"
                android:text="☰"
                android:textSize="24sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Fundamentus Logo"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/fundamentus_logo" />

        </LinearLayout>

        <!-- Suche/Filterinhos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/textStocksTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stocks"
                android:textSize="26sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/suchTextEingabe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Ticker oder Unternehmen suchen"
                android:inputType="text" />

            <Button
                android:id="@+id/aktienSucheButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Suchen" />

            <Spinner
                android:id="@+id/spinnerSectorFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:entries="@array/sector_filter_auswahl" />

            <Spinner
                android:id="@+id/spinnerWatchlistFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:entries="@array/watchlist_filter_auswahl" />

        </LinearLayout>

        <!-- Aktienübersicht -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/stockContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp" />

        </ScrollView>

    </LinearLayout>

    <!-- Navigationsmenü -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>